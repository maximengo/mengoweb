---
import Enlaces from "../components/Enlaces.astro";
import NavLink from "../components/NavLink.astro";
import DarkMode from "../components/DarkMode";
---

<header class="w-full sticky top-4 z-50">
  <div
    class="max-w-7xl mx-auto border border-slate-200 dark:border-slate-800 rounded-2xl bg-white dark:bg-slate-950 px-2 py-2 md:px-4 shadow-sm text-slate-800 dark:text-white transition-colors duration-300"
  >
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="/" class="inline-flex items-center gap-2.5 group">
        <div class="bg-cyan-500 p-1.5 rounded-lg text-white">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            class="w-5 h-5 md:h-6 md:w-6"
          >
            <path
              fill="currentColor"
              d="M0 1.5A1.5 1.5 0 0 1 1.5 0H9a1.5 1.5 0 0 1 1.5 1.5v21A1.5 1.5 0 0 1 9 24H1.5A1.5 1.5 0 0 1 0 22.5v-21Zm13.5 0A1.5 1.5 0 0 1 15 0h7.5A1.5 1.5 0 0 1 24 1.5V9a1.5 1.5 0 0 1-1.5 1.5H15A1.5 1.5 0 0 1 13.5 9V1.5Zm0 13.5a1.5 1.5 0 0 1 1.5-1.5h7.5a1.5 1.5 0 0 1 1.5 1.5V15v7.5a1.5 1.5 0 0 1-1.5 1.5H15a1.5 1.5 0 0 1-1.5-1.5V15Z"
            ></path>
          </svg>
        </div>

        <span class="text-lg md:text-xl font-bold tracking-tight font-outfit">
          Mengo<span class="text-cyan-500">Dev</span></span
        >
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-1 text-sm">
        <Enlaces />
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-2">
        <DarkMode client:load />

        <button
          type="button"
          data-modal-target="contact-modal"
          data-modal-toggle="contact-modal"
          class="hidden md:flex items-center gap-2 bg-slate-900 dark:bg-white text-white dark:text-slate-900 hover:bg-cyan-500 dark:hover:bg-cyan-500 hover:text-white dark:hover:text-white px-5 py-2 rounded-xl font-bold text-sm transition-colors shadow-sm"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.57 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
            ></path>
          </svg>
          <span>Contacto</span>
        </button>

        <button
          type="button"
          class="p-2 text-slate-800 dark:text-white lg:hidden hover:bg-slate-100 dark:hover:bg-slate-800 rounded-xl transition-colors"
          data-drawer-target="drawer-menu"
          data-drawer-show="drawer-menu"
          data-drawer-placement="right"
          aria-controls="drawer-menu"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</header>

<script>
  function setupSmoothScroll() {
    // Standard link click handling if needed
  }

  setupSmoothScroll();
  document.addEventListener("astro:page-load", setupSmoothScroll);
</script>
