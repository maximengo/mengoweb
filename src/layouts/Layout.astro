---
import "@fontsource-variable/inter";
import "@fontsource-variable/outfit";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Portfolio de Maxi Mengoni, desarrollador web especializado en Astro, Laravel y WordPress. Creando soluciones digitales de alto impacto.",
  image = "/images/yo.webp",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

import Header from "../layouts/Header.astro";
import Footer from "../layouts/Footer.astro";
import Contacto from "../components/Contacto.astro";
import Enlaces from "../components/Enlaces.astro";
import { ClientRouter } from "astro:transitions";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Maxi Mengoni",
  url: "https://mengo.com.ar",
  image: "https://mengo.com.ar/images/yo.webp",
  sameAs: ["https://www.linkedin.com/in/maximiliano-mengoni-2965ab4b/"],
  jobTitle: "Full Stack Developer",
  description:
    "Programador Full Stack especializado en soluciones web de alto rendimiento.",
};
---

<!doctype html>
<html class="scroll-smooth scroll-py-28" lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <!-- JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:global>
      :root {
        --accent: 0, 191, 255;
        --accent-gradient: linear-gradient(
          45deg,
          rgb(var(--accent)),
          #ffa500 30%,
          white 60%
        );
      }
      html {
        font-family: "Inter Variable", sans-serif;
        background-color: #f8fafc;
        color: #1e293b;
        scrollbar-gutter: stable;
      }
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Outfit Variable", sans-serif;
      }
      html.dark {
        background-color: #000000;
        color: #f1f5f9;
      }

      /* Custom scrollbar */
      ::-webkit-scrollbar {
        width: 10px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
      }
      ::-webkit-scrollbar-thumb {
        background: #e2e8f0;
        border-radius: 10px;
        border: 3px solid transparent;
        background-clip: content-box;
      }
      html.dark ::-webkit-scrollbar-thumb {
        background: #1e293b;
        border: 3px solid transparent;
        background-clip: content-box;
      }
      ::-webkit-scrollbar-thumb:hover {
        background-color: #cbd5e1;
      }
      html.dark ::-webkit-scrollbar-thumb:hover {
        background-color: #334155;
      }

      /* Selection */
      ::selection {
        background-color: rgba(6, 182, 212, 0.2);
        color: #0891b2;
      }
      html.dark ::selection {
        background-color: rgba(6, 182, 212, 0.3);
        color: #22d3ee;
      }
    </style>

    <script is:inline>
      const applyTheme = () => {
        const theme = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        if (theme === "dark" || (!theme && prefersDark)) {
          document.documentElement.classList.add("dark");
        } else {
          document.documentElement.classList.remove("dark");
        }
      };

      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />
    <ClientRouter />
  </head>
  <body
    class="relative text-slate-900 dark:text-slate-100 selection:bg-cyan-500/30"
  >
    <!-- Dynamic Premium Background (Mesh Gradient) -->
    <div
      class="fixed inset-0 -z-10 h-full w-full overflow-hidden bg-slate-100 dark:bg-black"
    >
      <!-- Spot 1: Cyan -->
      <div
        class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-cyan-500/10 dark:bg-cyan-600/5 blur-[120px] animate-blob"
      >
      </div>
      <!-- Spot 2: Blue -->
      <div
        class="absolute top-[20%] right-[-5%] w-[40%] h-[60%] rounded-full bg-blue-600/10 dark:bg-blue-700/5 blur-[130px] animate-blob [animation-delay:2000ms]"
      >
      </div>
      <!-- Spot 3: Indigo/Slate -->
      <div
        class="absolute bottom-[-10%] left-[20%] w-[45%] h-[45%] rounded-full bg-indigo-500/10 dark:bg-slate-900/10 blur-[110px] animate-blob [animation-delay:4000ms]"
      >
      </div>
      <!-- Spot 4: Subtle Cyan -->
      <div
        class="absolute top-[40%] right-[30%] w-[30%] h-[30%] rounded-full bg-cyan-300/5 dark:bg-cyan-950/5 blur-[100px] animate-blob [animation-delay:3000ms]"
      >
      </div>

      <!-- Vignette Overlay -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-slate-200/20 dark:to-black/40"></div>

      <!-- Subtle Overlay Grid -->
      <div
        class="absolute inset-0 bg-[radial-gradient(#00000005_1px,transparent_1px)] [background-size:32px_32px] dark:bg-[radial-gradient(#ffffff03_1px,transparent_1px)]"
      >
      </div>
    </div>

    <div class="mx-auto max-w-screen-xl my-4 px-6 sticky top-4 z-50">
      <Header />
    </div>

    <main
      class="mx-auto w-full max-w-screen-xl px-6 gap-4 lg:gap-6 flex flex-col pb-20 mt-4 lg:mt-6"
    >
      <slot />
      <Footer />
    </main>

    <Contacto />

    <!-- Full Screen Mobile Menu -->
    <div
      id="drawer-menu"
      class="fixed top-0 right-0 z-[60] h-screen w-full p-8 overflow-hidden transition-transform translate-x-full bg-white/95 dark:bg-slate-950/98 backdrop-blur-2xl flex flex-col"
      tabindex="-1"
    >
      <div class="flex items-center justify-between mb-8">
        <h5 class="text-2xl font-bold font-outfit">
          Mengo<span class="text-cyan-500">Dev</span>
        </h5>
        <button
          type="button"
          data-drawer-hide="drawer-menu"
          class="p-3 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-800 dark:text-white transition-all active:scale-90 shadow-sm"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M6 18L18 6M6 6l12 12"></path></svg
          >
        </button>
      </div>

      <div class="flex-grow flex flex-col justify-center items-center">
        <nav class="flex flex-col items-center gap-10 text-3xl">
          <Enlaces />
          
          <div class="pt-10 border-t border-slate-200 dark:border-white/10 w-full min-w-[240px]">
             <button
              type="button"
              data-modal-target="contact-modal"
              data-modal-toggle="contact-modal"
              data-drawer-hide="drawer-menu"
              class="flex w-full items-center justify-center gap-3 bg-cyan-600 text-white px-6 py-5 rounded-3xl font-bold text-xl transition-all shadow-xl shadow-cyan-500/20 active:scale-95"
            >
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.57 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
              </svg>
              <span>Hablemos</span>
            </button>
          </div>
        </nav>
      </div>
    </div>

    <script
      src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
      defer></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@2.5.1/dist/flowbite.min.js"></script>
    <script is:inline>
      const initMenu = () => {
        if (typeof initFlowbite === 'function') {
          initFlowbite();
        }

        const drawerLinks = document.querySelectorAll('#drawer-menu a, #drawer-menu button[data-modal-target]');
        drawerLinks.forEach(link => {
          link.addEventListener('click', () => {
            const closeBtn = document.querySelector('[data-drawer-hide="drawer-menu"]');
            if (closeBtn) {
              setTimeout(() => {
                closeBtn.click();
              }, 100);
            }
          });
        });
      };

      document.addEventListener('astro:page-load', initMenu);
      document.addEventListener('astro:after-swap', initMenu);
    </script>
  </body>
</html>
