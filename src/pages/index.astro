---
import Layout from "../layouts/Layout.astro";
import Bloque from "../components/Bloque.astro";
import Yo from "../components/Yo.astro";
import TimeLine from "../components/TimeLine.astro";
import TechStack from "../components/TechStack.astro";
import Proyectos from "../layouts/Proyectos.astro";
---

<Layout title="Maxi Mengoni | Full Stack Developer | Mendoza Argentina">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6">
    <!-- Profile (Yo) -->
    <div class="lg:col-span-4 h-full">
      <Yo />
    </div>

    <!-- Experience (TimeLine) -->
    <div class="lg:col-span-8 h-full flex flex-col gap-4 lg:gap-6">
      <TechStack />

      <Bloque clase="h-full">
        <TimeLine />
      </Bloque>
    </div>
  </div>

  <!-- Section 3: Proyectos Destacados -->
  <div class="">
    <Proyectos />
  </div>
</Layout>
