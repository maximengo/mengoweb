---
interface Props {
    title: string;
    clase?: string;
    aria?: string;
    link: string;
}

const { title, link , clase="bg-slate-500 hover:bg-slate-400", aria } = Astro.props;
---

<a
    target="_blank"
    rel="noopener noreferrer"
    href={link}
    aria-label={aria ? aria : title}
    class=`w-10 h-10 flex items-center justify-center text-white rounded-xl transition-all duration-300 hover:scale-110 active:scale-95 focus:ring-2 focus:ring-offset-2 focus:ring-cyan-500 outline-none shadow-sm ${clase}`
>
    <slot/>
</a>

