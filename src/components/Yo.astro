---
import Social from "../components/SocialButton.astro";
import { Image } from "astro:assets";
import yo from "../images/yo_nueva.webp";
import Bloque from "./Bloque.astro";
---

<Bloque data={{ id: "sobre-mi" }} clase="h-full relative overflow-hidden flex flex-col">
  <!-- Skeleton State -->
  <div id="yo-skeleton" class="animate-pulse flex flex-col h-full">
    <div
      class="w-full flex-grow h-[50vh] max-h-[50vh] sm:h-[70vh] sm:max-h-[70vh] lg:h-auto lg:min-h-[420px] bg-slate-200 dark:bg-slate-900/60 rounded-2xl"
    >
    </div>
    <div class="mt-6">
      <div class="h-8 bg-slate-200 dark:bg-slate-900/60 rounded-lg w-3/4 mb-3">
      </div>
      <div class="h-8 bg-slate-200 dark:bg-slate-900/60 rounded-lg w-1/2 mb-4">
      </div>
      <div class="space-y-2 mb-6">
        <div class="h-4 bg-slate-200 dark:bg-slate-900/60 rounded w-full"></div>
        <div class="h-4 bg-slate-200 dark:bg-slate-900/60 rounded w-5/6"></div>
      </div>
      <div class="h-8 bg-slate-200 dark:bg-slate-900/60 rounded-full w-32">
      </div>
    </div>
    <div class="flex gap-3 mt-auto pt-6">
      <div class="w-10 h-10 bg-slate-200 dark:bg-slate-900/60 rounded-xl"></div>
      <div class="w-10 h-10 bg-slate-200 dark:bg-slate-900/60 rounded-xl"></div>
    </div>
  </div>

  <!-- Actual Content (Hidden initially) -->
  <div
    id="yo-content"
    class="opacity-0 transition-opacity duration-500 flex flex-col h-full pointer-events-none hidden"
  >
    <div
      class="relative w-full flex-grow h-[50vh] max-h-[50vh] sm:h-[70vh] sm:max-h-[70vh] lg:h-auto lg:min-h-[420px] overflow-hidden rounded-2xl border border-slate-700/10 shadow-inner group/img"
    >
      <Image
        src={yo}
        alt="Foto de Maxi Mengoni"
        widths={[400, 800]}
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 100vw, 800px"
        class="absolute inset-0 h-full w-full object-cover object-top sm:object-center group-hover/img:scale-105 transition-transform duration-700"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-40"
      >
      </div>
    </div>

    <div class="mt-6">
      <h1
        class="text-2xl md:text-3xl font-light mb-2 text-pretty font-outfit leading-7 md:leading-9"
      >
        ¡Hola! Soy <br />
        <span class="font-bold text-slate-900 dark:text-white"
          >Maxi <span
            class="bg-clip-text text-transparent bg-gradient-to-r from-cyan-500 to-blue-500"
            >Mengo</span
          >ni.</span
        >
      </h1>
      <p
        class="text-slate-600 dark:text-slate-300 mb-4 text-base leading-relaxed"
      >
        <span class="font-semibold text-cyan-600 dark:text-cyan-400"
          >Programador Full Stack</span
        > orientado a experiencias web, con más de <span class="font-bold"
          >15 años</span
        > fusionando código y diseño para crear soluciones digitales excepcionales.
      </p>

      <div
        class="flex items-center gap-2 text-slate-500 dark:text-slate-400 text-sm bg-slate-100/50 dark:bg-slate-800/50 w-fit px-3 py-1.5 rounded-full border border-slate-200 dark:border-slate-700"
      >
        <svg
          class="w-4 h-4 text-orange-500"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            fill-rule="evenodd"
            d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
            clip-rule="evenodd"></path>
        </svg>
        <span>Mendoza, Argentina</span>
      </div>
    </div>

    <div class="sociales flex gap-3 pt-6 mt-auto">
      <Social
        link="https://www.linkedin.com/in/maximiliano-mengoni-2965ab4b/"
        aria="Perfil de LinkedIn de Maxi Mengoni"
        title="Linkedin"
        clase="bg-[#0077b5] hover:bg-[#0077b5]/90 text-white shadow-sm"
      >
        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            fill-rule="evenodd"
            d="M12.51 8.796v1.697a3.738 3.738 0 0 1 3.288-1.684c3.455 0 4.202 2.16 4.202 4.97V19.5h-3.2v-5.072c0-1.21-.244-2.766-2.128-2.766-1.827 0-2.139 1.317-2.139 2.676V19.5h-3.19V8.796h3.168ZM7.2 6.106a1.61 1.61 0 0 1-.988 1.483 1.595 1.595 0 0 1-1.743-.348A1.607 1.607 0 0 1 5.6 4.5a1.601 1.601 0 0 1 1.6 1.606Z"
            clip-rule="evenodd"></path>
          <path d="M7.2 8.809H4V19.5h3.2V8.809Z"></path>
        </svg>
      </Social>

      <Social
        link="mailto:mengo@hotmail.com.ar"
        aria="Correo de Maxi Mengoni"
        title="Email"
        clase="bg-slate-800 dark:bg-slate-700 hover:bg-slate-900 text-white shadow-sm"
      >
        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-width="2"
            d="m3.5 5.5 7.893 6.036a1 1 0 0 0 1.214 0L20.5 5.5M4 19h16a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Z"
          ></path>
        </svg>
      </Social>
    </div>
  </div>
</Bloque>

<script>
  function revealYo() {
    const skeleton = document.getElementById("yo-skeleton");
    const content = document.getElementById("yo-content");
    if (skeleton && content) {
      skeleton.style.display = "none";
      content.classList.remove("hidden", "pointer-events-none");
      setTimeout(() => {
        content.classList.add("opacity-100");
      }, 10);
    }
  }

  // Reveal after a short delay for premium feel or once loaded
  document.addEventListener("astro:page-load", () => {
    setTimeout(revealYo, 300);
  });

  // Initial load
  if (document.readyState === "complete") {
    setTimeout(revealYo, 300);
  } else {
    window.addEventListener("load", () => setTimeout(revealYo, 300));
  }
</script>
