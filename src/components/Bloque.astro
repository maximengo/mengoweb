---
const { cantidad = 1, clase = "", data = {} } = Astro.props;
---

<div
  {...data}
  class=`relative border border-slate-200/60 dark:border-white/5 dark:text-white rounded-[2rem] backdrop-blur-xl bg-white/80 dark:bg-slate-900/50 p-6 md:p-10 shadow-sm z-10 text-slate-800 flex flex-col col-span-${cantidad} ${clase}`
>
  <slot />
</div>
