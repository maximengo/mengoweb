---
const { title } = Astro.props;
---

<div
     data-tooltip-target={`tooltip-${title}`}
     class="swiper-slide group relative flex flex-col items-center justify-center rounded-xl p-3 duration-300 transition-[background-color,border-color,box-shadow,transform] bg-white dark:bg-slate-800/40 border border-slate-200 dark:border-white/5 hover:border-cyan-500/50 hover:bg-white dark:hover:bg-slate-800 hover:shadow-md hover:-translate-y-1 hover:cursor-help aspect-square !h-auto"
>
     <div class="transition-transform duration-300 group-hover:scale-110 flex items-center justify-center w-full h-full">
          <slot />
     </div>

     <div
          id={`tooltip-${title}`}
          role="tooltip"
          class="absolute z-[100] invisible inline-block px-3 py-1.5 text-xs text-white font-bold transition-opacity duration-300 bg-slate-900 dark:bg-cyan-600 rounded-lg shadow-xl opacity-0 tooltip"
     >
          {title}
          <div class="tooltip-arrow" data-popper-arrow></div>
     </div>
</div>

